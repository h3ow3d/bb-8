# BB-8 Kubernetes Sidekick — environment configuration
# Copy this file to .env and edit before starting the stack.

# API authentication token. CHANGE THIS before running in production.
SIDECAR_API_TOKEN=change-me

# Path to your kubeconfig file on the host machine.
KUBECONFIG_PATH=~/.kube/config

# Kubernetes context to use. Leave empty to use the current context.
K8S_CONTEXT=

# Ollama model to use for LLM inference.
# Must be pulled first with: scripts/pull-model.sh
OLLAMA_MODEL=qwen2.5:7b-instruct

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Image version tag (used when pulling from GHCR)
VERSION=latest
